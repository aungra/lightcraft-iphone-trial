+#[test]
+fn compact_phone_controls_and_photo_stay_inside_the_viewport() {
+    for size in [[320.0, 568.0], [402.0, 874.0], [874.0, 402.0], [402.0, 350.0]] {
+        for scale in [1.0, 2.0, 3.0] {
+            let h = app(size, scale);
+            let screen = Rect::from_min_size(egui::Pos2::ZERO, vec2(size[0], size[1]));
+            let buttons: Vec<_> = ["library", "import", "edit", "share", "menu"].iter().map(|id| rect(&h, &format!("compact:{id}-button"))).collect();
+            for (index, button) in buttons.iter().enumerate() {
+                assert!(screen.contains_rect(*button), "{size:?} at {scale}: {button:?}");
+                assert!(button.width() >= TOUCH && button.height() >= TOUCH);
+                for other in buttons.iter().skip(index + 1) {
+                    assert!(!button.intersects(*other) || button.intersect(*other).width() <= 0.0);
+                }
+            }
+            let tools = rect(&h, "compact:tools");
+            let photos = rect(&h, "compact:photos");
+            assert!(screen.contains_rect(tools));
+            assert!(screen.contains_rect(photos));
+            assert!(photos.bottom() <= tools.top() + 1.0);
+            assert!(photos.width() >= size[0] - 2.0);
+            assert!(photos.height() >= (size[1] - BAR) * 0.45);
+            let canvas = h.app.canvas_rect.unwrap();
+            assert!(screen.contains_rect(canvas) && canvas.height() >= 60.0, "photo squeezed out: {canvas:?}");
+            assert!(!h.app.widgets.iter().any(|(id, _)| id == "panel:left_panel" || id == "panel:right_panel"));
