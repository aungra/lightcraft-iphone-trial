+    // Use the visible Safari area, including keyboard/toolbar changes. Do not reflow the UI
+    // while the user pinch-zooms: the browser should magnify the existing layout instead.
+    export function viewportBox(viewport) {
+      if (!viewport || !Number.isFinite(viewport.scale) || Math.abs(viewport.scale - 1) > 0.01) return null;
+      if (![viewport.width, viewport.height, viewport.offsetLeft, viewport.offsetTop].every(Number.isFinite)) return null;
+      if (viewport.width <= 0 || viewport.height <= 0) return null;
+      return {
+        left: Math.max(0, viewport.offsetLeft), top: Math.max(0, viewport.offsetTop),
+        width: viewport.width, height: viewport.height,
+      };
+    }
+    if (typeof window !== "undefined" && window.visualViewport) {
+      const host = document.getElementById("lightcraft_viewport");
+      let frame = 0;
+      let previous = "";
+      const update = () => {
+        frame = 0;
+        const box = viewportBox(window.visualViewport);
+        if (!box || !host) return;
+        const key = JSON.stringify(box);
+        if (key === previous) return;
+        previous = key;
+        for (const [name, value] of Object.entries(box)) host.style[name] = `${value}px`;
+      };
+      const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
+      for (const event of ["resize", "scroll"]) window.visualViewport.addEventListener(event, schedule, { passive: true });
+      for (const event of ["resize", "orientationchange", "pageshow", "focusin", "focusout"]) window.addEventListener(event, schedule, { passive: true });
+      update();
+    }
+  </script>
