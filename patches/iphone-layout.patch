+    #[default]
+    Photos,
+    Library,
+    Menu,
+}
+
+/// Use the compact workspace before the normal columns consume the photo's minimum width.
+/// This is in egui points, so Retina pixels and browser zoom do not change the fit decision.
+pub(crate) fn needed(width: f32, t: &Tokens) -> bool {
+    width < crate::state::LEFT_WIDTH.default + crate::state::RIGHT_WIDTH.default + crate::state::MIN_PHOTO_WIDTH + t.strip_w
+}
+
+pub(crate) fn active(ctx: &egui::Context) -> bool {
+    // This trial changes the browser frontend only. A narrow native window must retain its
+    // saved dock and desktop controls; headless tests explicitly emulate the browser host.
+    let browser = cfg!(target_arch = "wasm32");
+    #[cfg(test)]
+    let browser = browser || ctx.data(|d| d.get_temp::<bool>(Id::unique("compact-web-host"))).unwrap_or(false);
+    browser && needed(ctx.content_rect().width(), &Tokens::get(ctx))
+}
+
+#[cfg(test)]
+fn emulate_web_host(ctx: &egui::Context) {
+    ctx.data_mut(|d| d.insert_temp(Id::unique("compact-web-host"), true));
+}
+
+fn page(ctx: &egui::Context) -> Page {
+    ctx.data(|d| d.get_temp(Id::unique("compact-page"))).unwrap_or_default()
+}
+
+fn set_page(ctx: &egui::Context, page: Page) {
+    ctx.data_mut(|d| d.insert_temp(Id::unique("compact-page"), page));
+}
+
+pub(crate) fn exposed(app: &LightcraftApp, ctx: &egui::Context, panel: crate::docking::Panel) -> bool {
+    use crate::docking::Panel;
+    match panel {
+        Panel::Canvas => page(ctx) == Page::Photos,
+        Panel::Library => page(ctx) == Page::Library,
+        Panel::Tools => page(ctx) == Page::Photos && !app.ui.presets && app.ui.right != RightPanel::None,
+        Panel::Presets => page(ctx) == Page::Photos && app.ui.presets,
+    }
+}
+
+pub(crate) fn reveal(ctx: &egui::Context, panel: crate::docking::Panel) {
+    set_page(ctx, if panel == crate::docking::Panel::Library { Page::Library } else { Page::Photos });
+}
+
+pub fn show(app: &mut LightcraftApp, ui: &mut egui::Ui) {
+    let t = Tokens::get(ui.ctx());
+    if app.ui.focus_search {
+        set_page(ui.ctx(), Page::Menu);
+    }
+    toolbar(app, ui, &t);
+    super::library_problem::banner(app, ui);
+    if page(ui.ctx()) != Page::Photos {
+        app.canvas_rect = None;
+        app.image_rect = None;
+    }
+    egui::CentralPanel::default().frame(egui::Frame::NONE.fill(t.chrome)).show(ui, |ui| match page(ui.ctx()) {
+        Page::Library => {
+            register(ui, "compact:library", ui.max_rect());
+            egui::ScrollArea::horizontal().auto_shrink([false, false]).show(ui, |ui| super::left::show(app, ui));
+        }
+        Page::Menu => {
+            register(ui, "compact:menu", ui.max_rect());
+            if menu(app, ui) {
+                set_page(ui.ctx(), Page::Photos);
+            }
+        }
+        Page::Photos => photos(app, ui),
+    });
+}
+
+fn toolbar(app: &mut LightcraftApp, ui: &mut egui::Ui, t: &Tokens) {
+    egui::Panel::top("compact-toolbar").exact_size(BAR).frame(egui::Frame::NONE.fill(t.chrome)).show(ui, |ui| {
+        crate::widgets::announce_region(ui, egui::accesskit::Role::Toolbar, crate::i18n::tr("Top bar"));
+        let full = ui.max_rect();
+        let width = full.width() / 5.0;
+        for (index, (id, label, icon)) in [
+            ("library", "Library", Icon::Sidebar),
+            ("import", "Import", Icon::Plus),
+            ("edit", "Edit", Icon::Sliders),
+            ("share", "Export", Icon::Share),
+            ("menu", "Menu", Icon::More),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let r = Rect::from_min_size(pos2(full.left() + index as f32 * width, full.top()), vec2(width, BAR));
+            let enabled = !matches!(id, "edit" | "share") || app.session.active().is_some();
+            let resp = ui.interact(r, Id::unique(("compact-action", id)), if enabled { Sense::click() } else { Sense::hover() });
+            let label = crate::i18n::tr(label);
+            resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, enabled, label));
+            register(ui, format!("compact:{id}-button"), r);
+            let selected = match id {
+                "library" => page(ui.ctx()) == Page::Library,
+                "menu" => page(ui.ctx()) == Page::Menu,
+                "edit" => page(ui.ctx()) == Page::Photos && (app.ui.right != RightPanel::None || app.ui.presets),
+                _ => false,
+            };
+            if selected || (enabled && resp.hovered()) {
+                ui.painter().rect_filled(r.shrink(2.0), 4.0, t.hover);
+            }
+            let color = if enabled { t.text } else { t.text_disabled };
+            paint(ui.painter(), Rect::from_center_size(pos2(r.center().x, r.top() + 18.0), vec2(22.0, 22.0)), icon, color);
+            ui.painter().text(pos2(r.center().x, r.bottom() - 13.0), Align2::CENTER_CENTER, label, t.font(11.0), color);
+            if resp.clicked() && enabled {
+                activate(app, ui.ctx(), id);
+            }
+        }
+    });
+}
+
+fn activate(app: &mut LightcraftApp, ctx: &egui::Context, id: &str) {
+    match id {
+        "library" => set_page(ctx, if page(ctx) == Page::Library { Page::Photos } else { Page::Library }),
+        "menu" => set_page(ctx, if page(ctx) == Page::Menu { Page::Photos } else { Page::Menu }),
+        "edit" => {
+            let close = page(ctx) == Page::Photos && (app.ui.right != RightPanel::None || app.ui.presets);
+            set_page(ctx, Page::Photos);
+            let _ = app.run(if close { "panel.close" } else { "panel.edit" }, json!({}));
+        }
+        "import" | "share" => {
+            if let Err(error) = app.run(if id == "import" { "file.addPhotos" } else { "dialog.export" }, json!({})) {
+                app.toast_error(ctx, error);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn photos(app: &mut LightcraftApp, ui: &mut egui::Ui) {
+    if app.ui.right != RightPanel::None || app.ui.presets {
+        // Half the available height, capped on tall phones. Even landscape/keyboard-sized
+        // viewports retain half for the photo; controls scroll instead of stealing that space.
+        let height = (ui.available_height() * 0.5).min(380.0);
+        egui::Panel::bottom("compact-tools").exact_size(height).frame(egui::Frame::NONE).show(ui, |ui| {
+            register(ui, "compact:tools", ui.max_rect());
+            tools(app, ui);
+            egui::ScrollArea::horizontal()
+                .id_salt("compact-tools-x")
+                .auto_shrink([false, false])
+                .show(ui, |ui| if app.ui.presets { super::presets::show(app, ui) } else { super::right::show(app, ui) });
+        });
+    }
+    register(ui, "compact:photos", ui.available_rect_before_wrap());
+    crate::docking::show_canvas(app, ui);
+}
+
+fn tools(app: &mut LightcraftApp, ui: &mut egui::Ui) {
+    egui::ScrollArea::horizontal().id_salt("compact-tool-tabs").auto_shrink([false, true]).show(ui, |ui| {
+        ui.horizontal(|ui| {
+            ui.spacing_mut().item_spacing.x = 0.0;
+            for (id, label, icon, panel) in [
+                ("edit", "Edit", Icon::Sliders, RightPanel::Edit),
+                ("crop", "Crop & Rotate", Icon::Crop, RightPanel::Crop),
+                ("presets", "Presets", Icon::Presets, RightPanel::None),
+                ("remove", "Remove", Icon::Eraser, RightPanel::Remove),
+                ("masking", "Masking", Icon::Mask, RightPanel::Masking),
+                ("info", "Info", Icon::Info, RightPanel::Info),
+                ("versions", "Versions", Icon::Versions, RightPanel::Versions),
+            ] {
+                let selected = if id == "presets" { app.ui.presets } else { !app.ui.presets && app.ui.right == panel };
+                if icon_button(ui, &format!("compact-{id}"), icon, vec2(TOUCH, TOUCH), selected, true, label).clicked() {
+                    if id != "presets" {
+                        app.ui.presets = false;
+                    }
+                    let _ = app.run(&format!("panel.{id}"), json!({}));
+                }
+            }
+        });
+    });
+}
+
+/// A drill-in menu uses one full-width level, never side-by-side popups. The shared command
+/// model supplies enabled/checked state and translated labels, exactly as on desktop.
+fn menu(app: &mut LightcraftApp, ui: &mut egui::Ui) -> bool {
+    use crate::menubar::MenuNode;
+    let roots: Vec<_> = crate::menubar::menu_bar(app).into_iter().map(|(label, children)| MenuNode::Submenu { label, children }).collect();
+    let key = Id::unique("compact-menu-path");
+    let mut path: Vec<usize> = ui.data(|d| d.get_temp(key)).unwrap_or_default();
+    let mut rows = roots.as_slice();
+    let mut title = "Menu";
+    let mut valid = 0;
+    // Menus can contain user data; bound depth and safely drop a stale selection after changes.
+    for index in path.iter().take(16) {
+        let Some(MenuNode::Submenu { label, children }) = rows.get(*index) else { break };
+        rows = children;
+        title = label;
+        valid += 1;
+    }
+    path.truncate(valid);
+    let mut selected = None;
+    let mut enter = None;
+    let mut back = false;
+    ui.horizontal(|ui| {
+        back = icon_button(ui, "compact-menu-back", Icon::Back, vec2(TOUCH, TOUCH), false, !path.is_empty(), "Back").clicked();
+        ui.label(crate::i18n::tr(title));
+    });
+    super::topbar::compact_search(app, ui);
+    egui::ScrollArea::vertical().id_salt(("compact-menu-list", &path)).min_scrolled_height(0.0).auto_shrink([false, false]).show(ui, |ui| {
+        ui.spacing_mut().interact_size.y = TOUCH;
+        for (index, node) in rows.iter().enumerate() {
+            match node {
+                MenuNode::Separator => {
+                    ui.separator();
+                }
+                MenuNode::Submenu { label, .. } => {
+                    let resp = ui.add_sized(vec2(ui.available_width(), TOUCH), egui::Button::new(crate::i18n::tr(label)).wrap());
+                    register(ui, format!("menusub:{label}"), resp.rect);
+                    if resp.clicked() && path.len() < 16 {
+                        enter = Some(index);
+                    }
+                }
+                MenuNode::Item { id, params, label, enabled, checked, .. } => {
+                    let label = crate::menubar::display_item_label(id, params, label);
+                    let button = egui::Button::new(label).selected(*checked == Some(true)).wrap();
+                    let resp = ui.add_enabled_ui(*enabled, |ui| ui.add_sized(vec2(ui.available_width(), TOUCH), button)).inner;
+                    register(ui, format!("menuitem:{id}"), resp.rect);
+                    if resp.clicked() {
+                        selected = Some((id.clone(), params.clone()));
+                    }
+                }
+            }
+        }
+    });
+    if back {
+        path.pop();
+    } else if let Some(index) = enter {
+        path.push(index);
+    }
+    ui.data_mut(|d| d.insert_temp(key, path));
+    if let Some((id, params)) = selected {
+        if let Err(error) = crate::menubar::run_item(app, &id, params) {
+            app.toast_error(ui.ctx(), error);
+        }
+        return true;
+    }
+    false
+}
